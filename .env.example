# ==============================================
# 글로벌 일일 브리핑 - 환경설정 파일
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채워주세요
# ==============================================

# OpenAI API 키 (https://platform.openai.com 에서 발급)
OPENAI_API_KEY=sk-여기에붙여넣기

# 텔레그램 봇 토큰 (@BotFather에서 발급 - 아래 안내 참조)
TELEGRAM_BOT_TOKEN=여기에붙여넣기

# 텔레그램 채팅 ID (아래 안내 참조)
TELEGRAM_CHAT_ID=여기에붙여넣기
